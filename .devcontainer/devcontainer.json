{
  "name": "php83-fast",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.3",
  "features": {
    "ghcr.io/devcontainers/features/composer:1": {}
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "PHP Server",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "composer install --no-interaction --prefer-dist",
  "postStartCommand": "php -S 0.0.0.0:8000 -t ."
}
